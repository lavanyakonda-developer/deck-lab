# Copy this file to .env.local and fill in your own value.
# .env.local is gitignored and must never be committed.

# OpenAI API key used by server-side routes only (never exposed to the client).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Default model used for slide generation and chat-based refinement (Phase 3+).
OPENAI_MODEL=gpt-4o
