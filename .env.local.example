# Copy this file to .env.local and fill in your own value.
# .env.local is gitignored and must never be committed.

# OpenAI API key used by server-side routes only (never exposed to the client).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Default model used for slide generation and chat-based refinement (Phase 3+).
OPENAI_MODEL=gpt-4o

# Image model for AI-generated slide images. OpenAI retires image models over
# time - if images fail with "model does not exist", change this.
OPENAI_IMAGE_MODEL=gpt-image-2

# Optional: how many prior chat messages are resent to OpenAI per request
# (default 10). Set to 0 to disable the cap - used by the context-growth eval.
# CHAT_MAX_HISTORY_MESSAGES=10
